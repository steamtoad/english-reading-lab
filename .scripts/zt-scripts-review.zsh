#!/bin/zsh

#------------------------------------------------------------------------------
# zt-scripts-review.zsh
# Тип: Maintenance
# Назначение: вывод всех shell-скриптов zettelkasten-cli для ревизии
#------------------------------------------------------------------------------

emulate -L zsh
setopt extended_glob null_glob

script_dir="${0:A:h}"

for f in "$script_dir"/**/*.zsh(N); do
  [[ -f "$f" ]] || continue

  print -r -- ""
  print -r -- "=============================================================================="
  print -r -- "FILE: ${f#$script_dir/}"
  print -r -- "=============================================================================="
  cat "$f"
done

exit 0
